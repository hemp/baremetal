#!/bin/zsh

echo "install-packages:"

# shellcheck source=/dev/null
source "$HOME/.oh-my-zsh/oh-my-zsh.sh"
if [[ $(uname -m) == 'arm64' ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
echo "HOMEBREW_BUNDLE_FILE: ${XDG_CONFIG_HOME}/homebrew/Brewfile"
brew bundle install --global
# Drift: installed but not in the Brewfile. May be intentional (machine-specific
# tools not yet codified), so this is informational only — auto-declined.
echo -e "\n---\n👀 Drift — installed but not in Brewfile (auto-declined; codify or remove manually):\n"
echo "N" | brew bundle cleanup --global
echo -e "---\n"
# https://gist.github.com/davidteren/898f2dcccd42d9f8680ec69a3a5d350e
brew search '/font-.*-(nerd-font|nf)/' | awk '{ print $1 }' | xargs brew install || true
# brew cleanup

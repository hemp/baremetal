#!/bin/bash

set -euo pipefail

echo "install-packages:"

ITERATION0_APT=(
  apt-listbugs
  apt-listchanges
  bat
  build-essential
  broot
  btop
  chezmoi
  curl
  du-dust
{{ if eq .machineType "server" }}
  emacs-nox
{{ else }}
  emacs
{{ end }}
  extrepo
  eza
  fontconfig
  fastfetch
  fd-find
  fzf
  git
  git-delta
  gpg
  hexyl
  iperf3
  jq
  lazygit
  libimage-exiftool-perl
  libssl-dev
  lm-sensors
  lshw
  neovim
  nmap
  numbat
  nvtop
  pkg-config
  ranger
  ripgrep
  sudo
  tealdeer
  wget
  zoxide
  zsh
)

sudo apt-get install -y "${ITERATION0_APT[@]}"

sudo extrepo enable mise
sudo apt-get update
sudo apt-get install -y mise

{{ if eq .machineType "server" -}}

ITERATION1_SERVER=(
  openssh-server
)

sudo apt-get install -y "${ITERATION1_SERVER[@]}"

{{- else -}}

sudo extrepo enable vscode
sudo apt-get update

ITERATION1=(
  alacritty
  code
  direnv
  easyeffects
  firefox
  foot
  foot-terminfo
  gimp
  hx
  inkscape
  mpv
  obs-studio
  vlc
)

sudo apt-get install -y "${ITERATION1[@]}"

# EasyEffects 8.x presets (Debian sid)
EASYEFFECTS_PRESETS_REPO="$HOME/.easyeffects-presets"
EASYEFFECTS_PRESETS_DIR="${XDG_DATA_HOME:-"$HOME/.local/share"}/easyeffects/output"

if [ ! -d "$EASYEFFECTS_PRESETS_REPO" ]; then
  git clone --depth=1 https://github.com/Digitalone1/EasyEffects-Presets.git "$EASYEFFECTS_PRESETS_REPO"
fi

mkdir -p "$EASYEFFECTS_PRESETS_DIR"
for preset in LoudnessEqualizer.json LoudnessCrystalEqualizer.json; do
  ln -sfn "$EASYEFFECTS_PRESETS_REPO/$preset" "$EASYEFFECTS_PRESETS_DIR/$preset"
done

"$HOME/.local/bin/install-fonts.sh"

{{- end }}

sudo apt-get autoremove -y

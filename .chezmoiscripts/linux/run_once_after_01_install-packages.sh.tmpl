#!/bin/bash

echo "install-packages:"

ITERATION0_APT=(
  curl
  git
  gpg
  jq
  sudo
  wget
  zsh
)

sudo apt-get install -y "${ITERATION0_APT[@]}"

# lunarvim
bash <(curl -s https://raw.githubusercontent.com/lunarvim/lunarvim/master/utils/installer/install.sh)

{{ if eq .machineType "server" -}}

ITERATION1_SERVER=(
  openssh-server
)

sudo apt-get install -y "${ITERATION1_SERVER[@]}"

{{- else -}}

ITERATION1=(
  # audacious
  # audacious-plugins
  # chromium-browser
  # conky-all
  # diffuse
  # firefox
  # fonts-inconsolata
  # git-cola
  # i3
  # network-manager-openvpn
  # network-manager-openvpn-gnome
  # openvpn
  # qgit
  # shutter
  # tig
  # vlc
  direnv
  easyeffects
)

sudo apt-get install -y "${ITERATION1[@]}"

# EasyEffects 8.x presets (Debian sid)
EASYEFFECTS_PRESETS_REPO="$HOME/.easyeffects-presets"
EASYEFFECTS_PRESETS_DIR="${XDG_DATA_HOME:-"$HOME/.local/share"}/easyeffects/output"

if [ ! -d "$EASYEFFECTS_PRESETS_REPO" ]; then
  git clone --depth=1 https://github.com/Digitalone1/EasyEffects-Presets.git "$EASYEFFECTS_PRESETS_REPO"
fi

mkdir -p "$EASYEFFECTS_PRESETS_DIR"
for preset in LoudnessEqualizer.json LoudnessCrystalEqualizer.json; do
  ln -sfn "$EASYEFFECTS_PRESETS_REPO/$preset" "$EASYEFFECTS_PRESETS_DIR/$preset"
done

# vscode
# wget -q "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64" -O /tmp/vscode-latest.deb
# sudo apt install /tmp/vscode-latest.deb
# sudo rm /tmp/vscode-latest.deb

{{- end }}

{{ if ne .chezmoi.arch "arm64" -}}

# homebrew does not support arm
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

ITERATION_BREW=(
  bat
  bottom
  btop
  ctop
  dive
  dust
  eza
  fd
  fzf
  git-delta
  lazygit
  neovim
  ranger
  ripgrep
  tealdeer
  the_silver_searcher
)

brew install "${ITERATION_BREW[@]}"

sudo apt install fontconfig
brew install --cask font-meslo-lg-nerd-font

{{- end }}

sudo apt autoremove
